# 鸿蒙引擎 har 与依赖（体积大，由 ohpm install 生成）
ohos/**/oh_modules/
ohos/**/node_modules/

# 本地插件包的构建产物
packages/**/.dart_tool/
packages/**/build/

# 鸿蒙签名信息（含密钥路径，不提交到公开仓库）
ohos/build-profile.json5.local

# DevEco / IDE 生成的助手目录（内部自带 .git，会被误识别为 submodule）
.codegenie/
**/.codegenie/
.idea/
.vscode/
*.hap
*.hsp
*.app

# 其他
